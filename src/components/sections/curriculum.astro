---
import TechnologyGroups from "./technologyGroups.astro";
---

<section id="cv" class="container portfolio-container placeholder-section">
  <h2>CV</h2>

  <div class="cv-download">
    <a href="/cv.pdf" download="CV_Alvaro_Cantero_Cardenas.pdf" class="cv-download-link">
      Descargar CV
    </a>
  </div>

  <TechnologyGroups />
</section>

<style>
  .cv-download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .cv-download h3 {
    margin: 0;
    color: var(--heading);
  }

  .cv-download-link {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border: 1px solid #d1d1d1;
    border-radius: 6px;
    background: #fff;
    color: #111;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .cv-download-link:hover {
    background: #e8e8e8;
  }
</style>