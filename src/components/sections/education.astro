---
import TimelineCard from "../ui/TimeLineCard.astro";
import { academicEducation, onlineCourses } from "../../data/education";
---

<section id="education" class="container portfolio-container placeholder-section">
  <div class="education-header">
    <h2 class="text-center">Formación</h2>
  </div>

  <ul class="nav nav-pills education-tabs justify-content-center" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#education-academic"
      type="button" role="tab" aria-controls="education-academic" aria-selected="true">
      Formación académica
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#education-courses"
      type="button" role="tab" aria-controls="education-courses" aria-selected="false">
      Cursos online
    </button>
  </li>
</ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="education-academic" role="tabpanel">
      <div class="d-flex flex-column gap-3">
        {academicEducation.map((item) => (
          <TimelineCard title={item.title} subtitle={item.center} start={item.start} end={item.end}>
            {item.place && <span><i class="fa-solid fa-location-dot"></i> {item.place}</span>}
            
          </TimelineCard>
        ))}
      </div>
    </div>

    <div class="tab-pane fade" id="education-courses" role="tabpanel">
      <div class="d-flex flex-column gap-3">
        {onlineCourses.map((item) => (
          <TimelineCard title={item.title} subtitle={item.center} end={item.end}>
            <a href={item.certificate} target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-certificate"></i> Ver certificado
            </a>
          </TimelineCard>
        ))}
      </div>
    </div>
  </div>
  <hr>
   <p class="description mx-auto">
    Si quieres ver más información sobre mi formación, puedes visitar mi 
      <a href="https://www.linkedin.com/in/alvarocanterocardenas" target="_blank" rel="noopener noreferrer"> LinkedIn</a>.
  </p>
</section>

<style>
  .education-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 1.2rem;
  }

  /* Pestañas */
  .education-tabs {
    gap: 12px;
    margin-bottom: 20px;
  }

  .education-tabs .nav-link {
    padding: 6px 16px;
    border: 1px solid #fff;
    border-radius: 5px;
    background: #fff;
    color: #111;
    font-size: 13px;
    line-height: 1.4;
  }

  .education-tabs .nav-link:hover {
    background: #e8e8e8;
  }

  .education-tabs .nav-link:focus-visible {
    box-shadow: none;
    outline: 1px solid var(--heading);
    outline-offset: 2px;
  }

  .tab-content {
    display: grid;
  }

  .tab-content > .tab-pane {
    grid-area: 1 / 1;
    display: block;
    visibility: hidden;
  }

  .tab-content > .tab-pane.active {
    visibility: visible;
  }
  .description {
  max-width: 680px;
  margin: 0 0 20px;
  }

  .description a {
    color: #f4f4f4;
    text-decoration: none;
  }

  .description a:hover {
    color: #f4f2f5;
  }
</style>