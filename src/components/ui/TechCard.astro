---
import Card from "./Card.astro";
const { title } = Astro.props;
---

<Card>
  <div class="tech-body" role="group" aria-label={title}>
    <h3 class="tech-title">{title}</h3>
    <div class="icons"><slot /></div>
  </div>
</Card>

<style>
  .tech-body {
    padding: 16px 18px;
  }

  .tech-title {
    margin: 0 0 12px;
    color: #8b95a7;
    font-size: 12px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase;
  }

  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .icons :global(i) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: #1a1a1e;
    color: #f4f4f4;
    font-size: 22px;
    line-height: 1;
    transition: border-color 0.2s ease;
  }

  .icons :global(i:hover) {
    border-color: #f7f7f7;
  }
</style>